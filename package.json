    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
